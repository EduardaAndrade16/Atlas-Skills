# ==============================================================================
# ATLAS SKILLS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (React + Vite)
# ------------------------------------------------------------------------------
# URL base da API REST do backend Spring Boot
VITE_API_URL="http://localhost:8080/api/v1"

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Java 17 + Spring Boot 3)
# O backend inicia por padrão com H2 Database em memória (zero instalação externa).
# H2 Console: http://localhost:8080/api/v1/h2-console (JDBC URL: jdbc:h2:mem:atlas_skills_db, Usuário: sa, Senha: em branco)
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# Chave secreta de 256 bits para assinatura HMAC-SHA256 dos tokens JWT (Base64)
JWT_SECRET="dGhpcy1pcy1hLXNlY3VyZS1hdGxhcy1za2lsbHMtMjU2LWJpdC1qd3Qtc2VjcmV0LWtleS1mb3ItZGV2ZWxvcG1lbnQ="
# Tempo de expiração do token JWT em milissegundos (86400000 = 24 horas)
JWT_EXPIRATION_MS=86400000

# (Opcional) Configurações para migração futura para MySQL (Profile: --spring.profiles.active=mysql)
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=atlas_skills_db
# DB_USERNAME=root
# DB_PASSWORD=root

# Origens permitidas para CORS
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# CLOUD / AI STUDIO PLATFORM (Auto-injected)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
